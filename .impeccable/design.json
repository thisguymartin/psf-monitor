      "html": "<button class=\"ds-quiet\">Refresh</button>",
      "css": ".ds-quiet{font:13px/1.45 var(--font-ui,ui-sans-serif);cursor:pointer;padding:5px 8px;border:1px solid var(--line,#36302a);border-radius:7px;color:var(--text-2,#bfb3a4);background:transparent;font-size:11.5px}.ds-quiet:hover{color:var(--text,#f2ece3);border-color:var(--line-strong,#4d443b);background:var(--layer-2,#25211d)}.ds-quiet:focus-visible { outline:2px solid var(--accent,#d97757);outline-offset:2px; }"
    },
    {
      "name": "Send action",
      "kind": "button",
      "refersTo": "button-send",
