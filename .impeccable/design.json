      "html": "<input class=\"ds-input\" aria-label=\"Model id\" placeholder=\"provider/model\">",
      "css": ".ds-input{font:12px/1.45 var(--font-ui,ui-sans-serif);padding:4px 8px;border:1px solid var(--line,#36302a);border-radius:5px;background:var(--layer,#1c1916);color:var(--text,#f2ece3);max-width:100%}.ds-input:hover{border-color:var(--line-strong,#4d443b)}.ds-input:focus-visible{outline:2px solid var(--accent,#d97757);outline-offset:0;border-color:var(--accent,#d97757)}"
    },
