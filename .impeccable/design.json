      "html": "<button class=\"ds-send\">Send message</button>",
      "css": ".ds-send{font:13px/1.45 var(--font-ui,ui-sans-serif);cursor:pointer;padding:10px 16px;min-height:42px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;color:var(--on-accent,#1d120c);background:var(--accent,#d97757)}.ds-send:hover{background:var(--accent-strong,#ee9677)}.ds-send:focus-visible { outline:2px solid var(--accent,#d97757);outline-offset:2px; }"
    },
